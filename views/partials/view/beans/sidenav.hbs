<sidenav>
    <div class="filter">
        <h4>Filter</h4>
        <form action="" method="POST" class="options">
            <h5>Origin</h5>
            <!-- NOTE : this should come from our data -->
            <select name="origin"> 
                <option value="1">Cavite</option>
                <option value="2">Laguna</option>
                <option value="3">Manila</option>
            </select>

            <h5>Variety</h5>
            <!-- NOTE : this should come from our data -->
            <select name="variety"> 
                <option value="Typica">Typica</option>
                <option value="Canephora">Canephora</option>
                <option value="Barako">Barako</option>
                <option value="Excelsa">Excelsa</option>
                <option value="Supremo">Supremo</option>
                <option value="Heirloom">Heirloom</option>
            </select>

            <h5>Roast Level</h5>
            <select name="roast_level"> 
                <option value="LIGHT">Light</option>
                <option value="MEDIUM">Medium</option>
                <option value="MEDIUM_DARK">Medium Dark</option>
                <option value="DARK">Dark</option>
            </select>

            <h5>Price Range</h5>
            <div class="price-range">
                <input type="number" name="min_price" placeholder="Min Price">
                <input type="number" name="max_price" placeholder="Max Price">
                <input type="submit" value="Apply" class="apply-btn"> 
            </div>
        </form>
    </div>

    <div class="sort">
        <h4>Sort By</h4>
        <form action="" method="POST">
            <select name="name"> 
                <option value="A-Z">Alphabetically, A-Z</option>
                <option value="Z-A">Alphabetically, Z-A</option>
                <option value="low-high">Price, Low-High</option>
                <option value="high-low">Price, High-Low</option>
            </select>
        </form>
    </div>
</sidenav>

<div class="vertical-divider"></div>