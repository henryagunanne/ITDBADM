<sidenav>
    <div class="filter">
        <h4>Filter</h4>
        <form action="" method="POST" class="options">
            <h5>Origin</h5>
            <!-- NOTE : this should come from our data -->
            <input type="checkbox" value="Cavite">Cavite<br>
            <input type="checkbox" value="Laguna">Laguna<br>
            <input type="checkbox" value="Manila">Manila<br>

            <h5>Farmer</h5>
            <input type="checkbox" value="Old McDonald">Old McDonald<br>
            <input type="checkbox" value="Pepperidge">Pepperidge<br>

            <input type="submit" value="Apply" class="apply-btn">  
        </form>
    </div>

    <div class="sort">
        <h4>Sort By</h4>
        <form action="" method="POST">
            <select name="name"> 
                <option value="A-Z">Alphabetically, A-Z</option>
                <option value="Z-A">Alphabetically, Z-A</option>
                <option value="low-high">Price, Low-High</option>
                <option value="high-low">Price, High-Low</option>
            </select>
        </form>
    </div>
</sidenav>

<div class="vertical-divider"></div>