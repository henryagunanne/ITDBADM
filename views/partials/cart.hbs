<div class="cart-container"> 
    <div class="cart-content">
        <h3>Your Cart</h3>
        <hr>

        {{#each items}}
        <div class="item">
            <img src="{{bean.bean_image_path}}" class="cart-item-img" />
            
            <div class="cart-info">
                <h5>{{bean.bean_name}}</h5>
                <p class="price">PHP {{bean.price_per_kg}}</p>

                <div class="qty-row">
                    <span>Quantity:</span>
                    <div class="qty-selector">
                        <button>-</button> 
                        <span>{{quantity}}</span> 
                        <button>+</button>
                    </div>
                </div>

                <p class="item-total">
                    Total: ₱{{multiply bean.price_per_kg quantity}}
                </p>
            </div>

            <button class="delete-btn">
                <img src="/common/bin.png">
            </button>
        </div>
        {{/each}}
        
        <div class="cart-footer">
            <hr>
            <div class="subtotal-row">
                <span class="label">Subtotal:</span>
                <span class="amount">₱{{total_price}}</span>
            </div>

            <button class="checkout-btn" onclick="location.href='/checkout'">
                Checkout
            </button>
        </div>
    </div>
</div>