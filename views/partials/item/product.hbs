<!-- product.hbs file -->
<div class="product-container">
    <div class="left-panel">
        <img src="{{selected.bean_image_path}}"/>
    </div>

    <div class="right-panel">
        <div class="description">
            <h3>{{selected.bean_name}}</h3>
            <pre>{{selected.description}}</pre>
            
            <table>
                <tr>
                    <td style="font-weight: bold;">Variety:</td>
                    <td>{{selected.variety}}</td>
                </tr>
                <tr>
                    <td style="font-weight: bold;">Origin Province: </td>
                    <td>{{selected.origin_province_id}}</td>
                </tr>
                <tr>
                    <td style="font-weight: bold;">Roast Level: </td>
                    <td>{{selected.roast_level}}</td>
                </tr>
            </table>

            <h4>PHP {{selected.price_per_kg}}/kg</h4>
        </div>

        <div class="option">
            <div class="controls">
                <div class="qty-selector">
                    <button>-</button> <span>0</span> <button>+</button>
                </div>
                <button class="add-btn">Add to Cart</button>
            </div>
        </div>
    </div>
</div>