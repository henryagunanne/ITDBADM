<!-- product-row.hbs -->
{{#each beans}}
<div class="product-row">
    <div class="product-items">
        {{#each this}}
            <div class="bean-item" onclick="window.location.href='/view/beans/{{bean_id}}'">
                <h4>{{bean_name}}</h4>
                <p>PHP {{price_per_kg}}/kg</p>
                <img src="{{bean_image_path}}">
                
                <div class="controls">
                    <div class="qty-selector">
                        <button>-</button> <span>0</span> <button>+</button>
                    </div>
                    <button class="add-btn">Add to Cart</button>
                </div>
            </div>
        {{/each}}
    </div>
</div>
{{/each}}